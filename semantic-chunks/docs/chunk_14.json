{"id":"docs_userguide_tradedata_bestentryoption_doc","label":"Best Entry Option Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/bestentryoption.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bestentryoption_best_entry_option_trade","label":"Best Entry Option Trade Type (Fx/Equity/Commodity)","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bestentryoption.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"ResetMinimum lets a Trigger Event reset the effective Index_Initial used in the payoff, so once triggered the strike observation history (not just the final level) determines the payout via TriggerLevel and Cap."},

{"id":"docs_userguide_tradedata_bond_doc","label":"Bond Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/bond.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bond_bond_data","label":"BondData Trade Component","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bond.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Supports both a short form keyed by SecurityId that pulls all terms from bond reference data, and a long form with an inline LegData block, so the same node schema serves as both a stand-alone trade and a reusable component of bond derivative trades."},

{"id":"docs_userguide_tradedata_bondforward_refdata_doc","label":"Bond Forward / T-Lock / J-Lock Trade Data (using reference data)","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondForward_refdata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondforward_refdata_forward_bond_trade","label":"ForwardBond Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondForward_refdata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondforward_refdata_tlock_jlock","label":"T-Lock / J-Lock Variant","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondForward_refdata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A T-Lock/J-Lock can be specified via a LockRate (yield) instead of a cash Amount, in which case settlement defaults to Cash and the payoff is (yield at maturity - LockRate) x DV01, optionally with a contractual dv01 overriding the bond-derived value."},

{"id":"docs_userguide_tradedata_bondtotalreturnswap_doc","label":"Bond Total Return Swap Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondTotalReturnSwap.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondtotalreturnswap_bondtrs_trade","label":"BondTRS Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondTotalReturnSwap.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Convertible Bonds are explicitly excluded as BondTRS underlyings; trade type TotalReturnSwap must be used instead, so BondTRS is scoped to vanilla (non-convertible) bond underlyings only."},
{"id":"docs_userguide_tradedata_bondtotalreturnswap_total_return_data","label":"TotalReturnData Component","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondTotalReturnSwap.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondtotalreturnswap_funding_data","label":"FundingData Component","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondTotalReturnSwap.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The funding leg's notional can be aligned automatically to the return leg via an Indexings node with FromAssetLeg set to true, removing the need to duplicate the asset leg's bond-price/FX notional schedule on the funding leg."},

{"id":"docs_userguide_tradedata_bondfuture_doc","label":"Bond Future Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondfuture.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondfuture_bond_future_trade","label":"BondFuture Trade Type / BondFutureData","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondfuture.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondfuture_reference_data","label":"BondFutureReferenceData","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondfuture.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"LastTradingDate/LastDeliveryDate can either be given explicitly or derived via ContractMonth/RootDate/ExpiryBasis/SettlementBasis/ExpiryLag/SettlementLag, following CME 'Understanding Treasury Futures' conventions (e.g. last delivery = last business day of delivery month, last trading = 7 business days earlier)."},
{"id":"docs_userguide_tradedata_bondfuture_ctd_selection","label":"Cheapest-to-Deliver (CTD) Selection","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondfuture.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Implements Hull's CTD rule: the deliverable bond minimizing bp-(sp*cf) is chosen at future expiry, where cf is the bond-specific conversion factor."},

{"id":"docs_userguide_tradedata_bondoption_doc","label":"Bond Option Trade Data (inline bond data)","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondoption.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondoption_bond_option_trade","label":"BondOption Trade Type (inline BondData)","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondoption.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},

{"id":"docs_userguide_tradedata_bondoption_refdata_doc","label":"Bond Option Trade Data (using bond reference data)","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondoption_refdata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondoption_refdata_bond_option_refdata_variant","label":"BondOption Trade Type (via Bond Reference Data)","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondoption_refdata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Only par-redemption vanilla bonds are supported in this reference-data-driven variant, and the payoff max(B-X,0) always discounts B as the dirty NPV regardless of whether PriceType/StrikeData express the strike as clean or dirty."},

{"id":"docs_userguide_tradedata_bondposition_doc","label":"Bond Position Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondposition.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondposition_bond_position_trade","label":"BondPosition Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondposition.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},

{"id":"docs_userguide_tradedata_bondrepo_doc","label":"Bond Repo Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/bondrepo.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_bondrepo_bond_repo_trade","label":"BondRepo Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/bondrepo.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"BondNotional on the repo leg is meant to be the haircut-adjusted effective collateral notional, so BondNotional x Bond Dirty Price x (1-Haircut) should reconcile with the cash leg's nominal at inception."},

{"id":"docs_userguide_tradedata_callablebond_doc","label":"Callable Bond Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/callablebond.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_callablebond_callable_bond_trade","label":"CallableBond Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/callablebond.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The trade node itself only carries SecurityId/BondNotional; the full call/put exercise schedule lives in a separate CallableBondReferenceData reference datum, so the same trade XML works regardless of how complex the embedded optionality is."},
{"id":"docs_userguide_tradedata_callablebond_call_data","label":"CallData (Issuer Call Terms)","file_type":"concept","source_file":"Docs/UserGuide/tradedata/callablebond.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Bermudan style is reused to express a single European exercise (a Bermudan exercise schedule with one date), rather than modelling European as a distinct style."},
{"id":"docs_userguide_tradedata_callablebond_put_data","label":"PutData (Investor Put Terms)","file_type":"concept","source_file":"Docs/UserGuide/tradedata/callablebond.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},

{"id":"docs_userguide_tradedata_callableswap_doc","label":"Callable Swap Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/callableswap.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_callableswap_callable_swap_trade","label":"CallableSwap Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/callableswap.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Leg directions (Payer flag) are from the client's own perspective, the opposite convention to a Swaption where legs are expressed from the long party's perspective, even though the OptionData node otherwise matches a Swaption's."},

{"id":"docs_userguide_tradedata_capfloor_doc","label":"Cap/Floor Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/capfloor.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_capfloor_capfloor_trade","label":"CapFloor Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/capfloor.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The collar sign convention (long cap, short floor) is defined as exactly opposite to a capped/floored Floating leg's own convention, and Caps/Floors must sit outside LegData since a CapFloor cannot itself have a capped/floored underlying leg."},

{"id":"docs_userguide_tradedata_cashposition_doc","label":"Cash Position Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/cashposition.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_cashposition_cash_position_trade","label":"CashPosition Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/cashposition.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},

{"id":"docs_userguide_tradedata_cbodata_doc","label":"Collateral Bond Obligation (CBO) Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/cbodata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_cbodata_cbo_trade","label":"CBO Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/cbodata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The short version specifies only CBOInvestment (TrancheName, Notional, StructureId) and resolves the full CBOStructure from a matching ReferenceDatum, mirroring the reference-data pattern used by Bond and CallableBond."},
{"id":"docs_userguide_tradedata_cbodata_cbo_investment","label":"CBOInvestment Component","file_type":"concept","source_file":"Docs/UserGuide/tradedata/cbodata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_cbodata_cbo_structure","label":"CBOStructure Component","file_type":"concept","source_file":"Docs/UserGuide/tradedata/cbodata.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"During the reinvestment period the model cannot handle full amortisation of underlying bonds; if bonds only partially amortise, outstanding balance is held constant until the reinvestment end date and then amortises faster afterward."},

{"id":"docs_userguide_tradedata_commodityapo_doc","label":"Commodity Average Price Option (APO) Trade Data","file_type":"document","source_file":"Docs/UserGuide/tradedata/commodityapo.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
{"id":"docs_userguide_tradedata_commodityapo_commodity_apo_trade","label":"CommodityAveragePriceOption (APO) Trade Type","file_type":"concept","source_file":"Docs/UserGuide/tradedata/commodityapo.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Exercise is at calculation period end (typically the last floating fixing date), in contrast to a Commodity Swaption where expiry precedes the underlying's start - distinguishing an APO's Asian-style averaging exercise from a swaption's pre-start decision."}
