{
  "nodes": [
    {"id": "docs_userguide_tradecomponents_tradecomponentsintro_trade_components", "label": "Trade Components (Introduction)", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/tradecomponentsintro.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frames trade components as reusable XML sub-nodes shared across trade data containers (e.g. a leg or schedule reused by many trade types), and notes components can nest other components, motivating a graph rather than a flat list of trade-type schemas."},
    {"id": "docs_userguide_tradecomponents_legdatanotionals_leg_data", "label": "LegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdatanotionals.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LegData is the umbrella trade component used within CapFloorData, SwapData, SwaptionData and EquitySwapData; its LegType value dispatches to exactly one typed sub-node (FixedLegData, FloatingLegData, CMSLegData, etc.), making it the single entry point for the whole family of coupon-payoff specifications."},
    {"id": "docs_userguide_tradecomponents_legdatanotionals_notionals", "label": "Notionals", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdatanotionals.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Notional value represents a bullet notional while multiple Notional child elements (optionally dated via a startDate attribute) represent an amortising/accreting schedule; the last entered value is held flat for any remaining coupons, avoiding the need to enumerate one value per coupon."},
    {"id": "docs_userguide_tradecomponents_legdatanotionals_fx_reset", "label": "FXReset", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdatanotionals.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for Rebalancing Cross-Currency Swaps to reset the leg notional to a fixed foreign-currency amount via an FX index fixing, decoupling the leg's denomination Currency from the currency its notional size is pegged to."},
    {"id": "docs_userguide_tradecomponents_legdatanotionals_settlement_data", "label": "SettlementData (Leg)", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdatanotionals.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only used for CommodityFixed and CommodityFloating leg types: converts the leg NPV from the commodity underlying currency to Currency via an FX fixing observed on FixingDate, which defaults to the payment date if not given."},
    {"id": "docs_userguide_tradecomponents_legdatanotionals_fixed_leg_data", "label": "FixedLegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdatanotionals.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_legdatanotionals_floating_leg_data", "label": "FloatingLegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdatanotionals.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_legdataamortisation_amortization_data", "label": "AmortizationData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/legdataamortisation.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sequence of AmortizationData blocks lets a leg switch amortisation Type mid-life (FixedAmount, RelativeToInitialNotional, RelativeToPreviousNotional, Annuity, LinearToMaturity); every block after the first requires StartDate and every block but the last requires EndDate, chaining blocks into contiguous sub-schedules. Not supported for trade type CapFloor."},
    {"id": "docs_userguide_tradecomponents_scheduledata_schedule_data", "label": "ScheduleData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/scheduledata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ScheduleData node can combine any number of Rules, Dates and Derived sub-nodes; the resulting schedule is the ordered concatenation of the individual schedules each sub-node generates, rather than requiring exactly one generation mode."},
    {"id": "docs_userguide_tradecomponents_scheduledata_rules_schedule", "label": "Rules-based Schedule", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/scheduledata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_scheduledata_dates_schedule", "label": "Dates-based Schedule", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/scheduledata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_scheduledata_derived_schedule", "label": "Derived Schedule", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/scheduledata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Derived schedule applies a Shift period plus Calendar/Convention adjustment to every date of a named BaseSchedule elsewhere in the same leg, letting a payment or fixing schedule be defined purely as an offset of a calculation schedule rather than duplicated rules."},
    {"id": "docs_userguide_tradecomponents_indexings_indexings", "label": "Indexings", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/indexings.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setting FromAssetLeg true lets the trade builder auto-populate a funding leg's Indexing blocks (and its implicit Notionals) from an associated asset leg's notional-reset details, so equity swaps and Bond TRS need not duplicate the reset schedule by hand."},
    {"id": "docs_userguide_tradecomponents_indexings_indexing", "label": "Indexing", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/indexings.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also used to model non-deliverable IR and Cross-Currency swaps by adding an FX Indexing (rather than an equity one) so notional flows expressed in a non-deliverable currency are converted for settlement in the deliverable currency."},
    {"id": "docs_userguide_tradecomponents_formulabasedlegdata_formulabased_leg_data", "label": "FormulaBasedLegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/formulabasedlegdata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_formulabasedlegdata_formula_expression_language", "label": "Formula Expression Language (Index field)", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/formulabasedlegdata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Index field is a small expression language over IBOR/CMS indices and constants supporting +,-,*,/, the operators gtZero()/geqZero() used to build capped/floored/barrier-contingent payoffs (e.g. a USD-CMS-barrier-contingent EUR-GBP CMS spread coupon), and functions abs, exp, log, min, max, pow."},
    {"id": "docs_userguide_tradecomponents_rangeaccrualleg_range_accrual_leg_data", "label": "RangeAccrualLegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/rangeaccrualleg.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supports two mutually exclusive modes selected implicitly by whether Coupons is populated with non-zero values: a fixed-rate mode that ignores the nested FloatingLegData's gearings/spreads, and a floating mode (gearing x Ibor + spread); both are scaled by the fraction of observation days the Ibor fixing falls within [LowerBound, UpperBound]."},
    {"id": "docs_userguide_tradecomponents_rangebound_range_bound", "label": "RangeBound", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/rangebound.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leverage sign convention differs by trade type: TaRFs may mix positive and negative Leverage across RangeBound nodes to reflect a switching buyer/seller, whereas Accumulators require all Leverage values within the same instrument to share one sign."},
    {"id": "docs_userguide_tradecomponents_yyleg_yy_leg_data", "label": "YYLegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/yyleg.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IrregularYoY toggles the coupon reference period from a fixed one-year lookback (the standard Year-on-Year rate) to the coupon's own accrual period, letting a YY leg pay a non-annual (e.g. 6M) inflation rate instead of a true year-on-year rate."},
    {"id": "docs_userguide_tradecomponents_zerocouponleg_zerocoupon_fixed_leg_data", "label": "ZeroCouponFixedLegData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/zerocouponleg.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repurposes the leg's DayCounter as the compounding exponent t in (1+r)^t rather than as an accrual fraction (which is instead fixed at 1 for this leg type only), and treats the \"1/1\" day counter specially as \"Year\" so t is not trivially always 1."},
    {"id": "docs_userguide_tradecomponents_optiondata_option_data", "label": "OptionData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/optiondata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For Swaptions, Callable Swaps and Index CDS Options, setting LongShort to Short flips the Payer indicator on the underlying instrument to be read from the counterparty's perspective, rather than negating the option's own economics directly."},
    {"id": "docs_userguide_tradecomponents_optiondata_exercise_dates", "label": "ExerciseDates / ExerciseSchedule", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/optiondata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required cardinality is style-dependent: exactly one ExerciseDate for European, exactly two (period start/end) for American, and two-or-more (or an ExerciseSchedule) for Bermudan."},
    {"id": "docs_userguide_tradecomponents_optiondata_exercise_fees", "label": "ExerciseFees", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/optiondata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A positive fee means the option holder pays on exercise, a negative fee means the holder receives on exercise; fees can be given as Absolute amounts or as a Percentage of the notional of the period immediately following the exercise date."},
    {"id": "docs_userguide_tradecomponents_optiondata_payment_data", "label": "PaymentData (Option Settlement)", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/optiondata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_optiondata_settlement_data", "label": "SettlementData (Option)", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/optiondata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_premiums_premiums", "label": "Premiums", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/premiums.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_premiums_premium", "label": "Premium", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/premiums.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sign convention: a positive Amount is paid by the option holder to the seller and results in a negative contribution to the NPV of a long option, mirroring the payoff sign convention used elsewhere in option trade components."},
    {"id": "docs_userguide_tradecomponents_premiums_deprecated_premium_schema", "label": "Deprecated Single-Premium Schema", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/premiums.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The legacy PremiumAmount/PremiumCurrency/PremiumPayDate triplet is retained only for backwards compatibility and must not be mixed with the newer Premiums/Premium node structure within the same trade."},
    {"id": "docs_userguide_tradecomponents_strikedata_strike_data", "label": "StrikeData", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/strikedata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_strikedata_strike_price", "label": "StrikePrice", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/strikedata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Currency sub-element takes on different meanings for Quanto vs Compo strikes: quoted in the underlying asset's currency for Quanto, but in the payment/leg currency for Compo, despite sharing the same XML field."},
    {"id": "docs_userguide_tradecomponents_strikedata_strike_yield", "label": "StrikeYield", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/strikedata.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "docs_userguide_tradecomponents_underlying_underlying", "label": "Underlying", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/underlying.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Underlying schema is reused across seven asset classes (Equity, FX, Commodity, InterestRate, Inflation, Credit, Bond); most fields (IdentifierType, Exchange, PriceType, FutureMonthOffset, Interpolation, BidAskAdjustment) are only meaningful for one specific Type and are otherwise unused."},
    {"id": "docs_userguide_tradecomponents_underlying_equity_underlying", "label": "Equity Underlying", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/underlying.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An ISIN-identified equity underlying requires both Currency and Exchange so it can be converted internally to a RIC code, whereas RIC, FIGI and BBG identifier types need no such conversion."},
    {"id": "docs_userguide_tradecomponents_underlying_commodity_underlying", "label": "Commodity Underlying", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/underlying.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With PriceType FutureSettlement, the referenced contract is resolved either explicitly (FutureContractMonth or FutureExpiryDate) or implicitly as the prompt future adjusted by FutureMonthOffset and rolled forward by DeliveryRollDays/DeliveryRollCalendar from the observation date."},
    {"id": "docs_userguide_tradecomponents_underlying_bond_underlying", "label": "Bond Underlying", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/underlying.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BidAskAdjustment corrects a bond basket's mid-market reference price to the bid or ask side, since bond baskets (e.g. CBO collateral) are often priced away from mid."},
    {"id": "docs_userguide_tradecomponents_underlying_underlying_basket", "label": "Underlying Basket (Weighted Underlyings)", "file_type": "concept", "source_file": "Docs/UserGuide/tradecomponents/underlying.tex", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Weight of zero effectively excludes an underlying from its basket without removing the node; in TotalReturnSwap baskets a negative weight on an EquityPosition flips flow direction relative to the leg's Payer flag, while a negative weight on an EquityOptionPosition is equivalent to inverting its LongShort flag."}
  ],
