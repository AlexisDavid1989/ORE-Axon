      "id": "docs_userguide_parameterisation_historicalreturnconfiguration_historical_return_configuration",
      "label": "Historical Return Configuration",
      "file_type": "document",
      "source_file": "Docs/UserGuide/parameterisation/historicalreturnconfiguration.tex",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Displacement should be set to a small positive value when a risk factor can approach zero, to avoid division-by-zero or negative-value issues in relative/log return computations; falling back to built-in default return types (log for curves, relative for spots/vols, absolute for recovery rates) preserves backward compatibility when no override file is supplied."
    },
    {
      "id": "docs_userguide_parameterisation_iborfallbackconfig_ibor_fallback_configuration",
      "label": "Ibor Fallback Configuration",
      "file_type": "document",
