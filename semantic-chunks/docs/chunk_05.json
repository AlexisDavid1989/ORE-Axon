      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A custom Ibor fallback configuration is provided mainly for testing purposes; normal operation relies on the standard built-in configuration of Ibor-to-RFR replacement rules."
    },
