    {"id":"docs_inflation_inflation_simulation_inflation_simulation","label":"Inflation Simulation (Zero-Inflation Curve Conventions)","file_type":"document","source_file":"Docs/Inflation/inflation_simulation.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Model drift is computed from the deseasonalised zero-inflation curve rather than the market curve, because the seasonality-adjusted market curve is a step function whose numerical differentiation produces spikes at month boundaries; seasonality is re-applied only at the output/publishing stage for stable discrete-time simulation."},
    {"id":"docs_models_openxva_models_cross_asset_model","label":"Cross Asset Model (XAssetModel)","file_type":"document","source_file":"Docs/Models/OpenXVA_Models.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_models_openxva_models_parametrization","label":"Model Parametrization Framework","file_type":"concept","source_file":"Docs/Models/OpenXVA_Models.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Constrained calibration parameters (e.g. positivity) are optimized in transformed, unconstrained variables via direct/inverse parametrization methods rather than rejecting inadmissible points in a constrained optimizer, for better numerical behaviour."},
