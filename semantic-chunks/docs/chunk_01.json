{
  "nodes": [
    {"id":"docs_amc_amc_amc","label":"American Monte Carlo (AMC) Module","file_type":"document","source_file":"Docs/AMC/amc.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"AMC replaces the classic NPV-cube generation with regression-based conditional NPVs computed directly from the cross-asset pricing model, trading the cost of implying full term structures (vols, correlations) from the model for speed on exotic deals (e.g. Bermudan swaptions), while guaranteeing model consistency between the exposure and pricing measures that the classic engine cannot guarantee unless all market scenarios are fully implied by the cross asset model."},
    {"id":"docs_amc_amc_amccalculator","label":"AmcCalculator Interface","file_type":"concept","source_file":"Docs/AMC/amc.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_bondpricingconfig_bondpricingconfig_bond_pricing_configuration","label":"Bond Pricing Configuration","file_type":"document","source_file":"Docs/BondPricingConfig/bondpricingconfig.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_codingstandards_ore_coding_standards_ore_coding_standards","label":"ORE Coding Standards","file_type":"document","source_file":"Docs/CodingStandards/ore_coding_standards.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Two repos (private codebase, public github) are maintained despite administrative overhead, in order to protect corporate/personal confidentiality, cleanly transfer pre-existing QRE IP, and allow private code review before public release."},
    {"id":"docs_commoditymodel_commoditymodel_one_factor_commodity_model","label":"One-Factor Commodity Model","file_type":"document","source_file":"Docs/CommodityModel/CommodityModel.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_commoditymodel_commoditymodel_multi_factor_commodity_model","label":"Multi-Factor (N-Factor) Commodity Model","file_type":"document","source_file":"Docs/CommodityModel/CommodityModel.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_commoditymodel_commoditymodel_1fschwartz_drift_adjustments","label":"One-Factor Schwartz Commodity Drift Adjustments","file_type":"document","source_file":"Docs/CommodityModel/CommodityModel_1FSchwartz.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Derives LGM- and bank-account-measure drift adjustments so that the zero-correlation restriction between commodity (COM) factors and other risk factors (IR/FX) in ORE's cross asset model can be relaxed."},
    {"id":"docs_computeenvironment_computeenvironment_computeenvironment","label":"ComputeEnvironment Interface","file_type":"document","source_file":"Docs/ComputeEnvironment/computeenvironment.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_computeenvironment_computeenvironment_opencl_framework","label":"OpenCL Framework","file_type":"concept","source_file":"Docs/ComputeEnvironment/computeenvironment.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One OpenCL context is created per device (shared across threads) rather than one per thread, because running several contexts in parallel on the same device was observed to cause high GPU memory usage and resource allocation errors."},
    {"id":"docs_computeenvironment_computeenvironment_gpu_code_generator","label":"GPU Code Generator","file_type":"concept","source_file":"Docs/ComputeEnvironment/computeenvironment.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_creditmodel_creditmodel_credit_migration_model","label":"Credit Migration Model","file_type":"document","source_file":"Docs/CreditModel/creditmodel.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_dim_dynamicsimm_dynamic_simm","label":"Dynamic SIMM","file_type":"document","source_file":"Docs/DIM/dynamicsimm.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Simple regression-based Dynamic Initial Margin is fast and reuses NPV simulation data but is only accurate for plain-vanilla linear products; Dynamic SIMM instead embeds AAD path-wise sensitivities directly into the AMC simulation to remain accurate for options/exotics at a moderate (roughly 2-12x) increase in computation time."},
    {"id":"docs_dim_dynamicsimm_isda_simm","label":"ISDA SIMM","file_type":"concept","source_file":"Docs/DIM/dynamicsimm.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_design_aad_automatic_differentiation","label":"Automatic / Adjoint Algorithmic Differentiation (AAD)","file_type":"document","source_file":"Docs/Design/aad.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
    {"id":"docs_design_aad_computation_graph","label":"Computation Graph (CG)","file_type":"concept","source_file":"Docs/Design/aad.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"ORE extracts an explicit Computation Graph from the scripted-trade AST instead of using Operator Overloading across the whole codebase, so that AAD's roughly 4x (practically ~10x) overhead is confined to the scripted trade module, AAD activation stays configurable without recompiling, and the 'classic' non-CG implementation remains available for validation."},
    {"id":"docs_design_ore_design_ore_architecture","label":"ORE Library Architecture (QuantExt / OREData / OREAnalytics)","file_type":"document","source_file":"Docs/Design/ore_design.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"QuantExt is kept as a separate extension library rather than a patched local copy of QuantLib, so ORE can swap in newer QuantLib releases freely and decouple its own bugfix cycle from QuantLib's release cycle; some QuantExt code is later upstreamed into QuantLib and then removed."},
    {"id":"docs_design_ore_design_scripted_trade_design","label":"Scripted Trade Design (AST, Script Engine, Scripting Models)","file_type":"document","source_file":"Docs/Design/ore_design.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},
