    {"id":"docs_scriptedtrade_docs_noteonpayccy_pay_currency_quanto","label":"Payment Currency / Quanto Payoff","file_type":"document","source_file":"Docs/ScriptedTrade/docs/noteonpayccy.tex","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Converting the natural payoff currency to a different settlement currency using the fair FX spot rate is deliberately excluded from payoff modeling because it has little to no impact on valuation and risk, even though such conversions are sometimes part of a trade's terms and conditions."},
