    {
      "id": "docs_userguide_pricing_rainbow_option_rainbow_option",
      "label": "Rainbow Option",
      "file_type": "concept",
      "source_file": "Docs/UserGuide/pricing/rainbow_option.tex",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Priced via correlated Black-Scholes processes for the underlyings calibrated to quoted market ATM volatility, valued by Monte Carlo simulation, because the payoff (call/put on max or min of a range of assets) depends jointly on multiple correlated underlyings and has no simple closed form; classified as MultiAssetOption in the scripted trade framework."
    },
    {
      "id": "docs_userguide_pricing_scriptedtrades_scriptedtrades",
      "label": "Scripted Trade Pricing Model Framework",
      "file_type": "document",
      "source_file": "Docs/UserGuide/pricing/scriptedtrades.tex",
      "source_location": "Pricing Model Details for Scripted Trades",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_userguide_pricing_scriptedtrades_blackscholes_mc",
      "label": "BlackScholes/MC Model-Engine Pair",
      "file_type": "concept",
      "source_file": "Docs/UserGuide/pricing/scriptedtrades.tex",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A single or multivariate Black-Scholes process is used for SingleAssetOption/MultiAssetOption classifications; the process is evolved using exact moments (allowing large time steps) when uncorrelated, or via Sobol low-discrepancy sequences with Brownian Bridge interpolation when a multivariate process has non-zero correlations, with each component's volatility term structure taken at the ATMF strike."
    },
    {
      "id": "docs_userguide_pricing_scriptedtrades_gaussiancam_mc",
      "label": "GaussianCam/MC Model-Engine Pair",
      "file_type": "concept",
      "source_file": "Docs/UserGuide/pricing/scriptedtrades.tex",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "IR components are represented by LGM1F models (calibrated to ATM coterminal swaptions), FX/EQ/COMM components by Black-Scholes processes with a stochastic drift term (calibrated to ATMF options), and the inflation component by a Dodgson-Kainth model (calibrated to coterminal inflation caps/floors), coupled by time-constant instantaneous correlation, chosen so IR-sensitive exotics (SingleUnderlyingIrOption/MultiUnderlyingIrOption/IrHybrid classifications) can be evolved with exact moments and large time steps."
    },
    {
      "id": "docs_userguide_pricing_strikeresettableoption_strike_resettable_option",
      "label": "Strike Resettable Option",
      "file_type": "concept",
      "source_file": "Docs/UserGuide/pricing/strikeresettableoption.tex",
      "source_location": null,
